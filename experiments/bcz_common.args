--dataset-dir=training_cache/oxe_core/bc_z
--adapter-pooling=cls
--max-tfrecord-episodes-per-schema=512
--max-samples-per-schema=6000
--tfrecord-splits=train
--chunk-size=16
--stride=4
--min-trajectory-steps=10
--seed=42
--batch-size=4
--epochs=20
--max-steps-per-epoch=120
--learning-rate=0.0002
--weight-decay=0.0001
--dropout=0.1
--gripper-target-mode=state
--no-balanced-sampling
--workers=0
--max-validation-batches=20
--metric-interval=5
--metric-batches=10
--metric-samples=4
--log-interval=20
