--dataset-dir=training_cache/oxe_core/bc_z
--output-dir=results/bcz_native_pool_baseline_v1
--split-manifest=results/bcz_first_command_protocol_v1/split_manifest.json
--offline-command-experiment
--bcz-target=native_commands
--bcz-current-gripper=continuous
--decoder-type=regression
--fusion-type=simple_concat
--gripper-head-type=mlp2
--chunk-size=10
--stride=4
--min-trajectory-steps=10
--max-tfrecord-episodes-per-schema=512
--max-samples-per-schema=6000
--tfrecord-splits=train
--seed=42
--batch-size=4
--epochs=3
--max-steps-per-epoch=0
--learning-rate=0.0003
--weight-decay=0.0001
--dropout=0.1
--gripper-target-mode=state
--no-balanced-gripper-loss
--no-balanced-sampling
--workers=0
--max-validation-batches=0
--metric-interval=1
--metric-batches=13
--metric-samples=4
--log-interval=20
